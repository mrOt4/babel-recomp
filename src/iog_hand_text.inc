/* label, language, text runs separated by | (see ApplyHand in iog_text.c).
 * Strings the European releases have no counterpart for. One run per line
 * of the USA text: keep each within ~24 characters (the box width).
 * French and German stay without accents: their fonts' accent codes have
 * not been checked against those ROMs. */

/* World map: where to travel. */
{"widestring_01CB66", "es", "¿Adónde quieres ir?"},
{"widestring_01CB66", "fr", "Ou voulez-vous aller?"},
{"widestring_01CB66", "de", "Wohin moechtest du?"},

{"widestring_0384C4", "es", "No tienes nada equipado."},
{"widestring_0384C4", "fr", "Rien n'est equipe."},
{"widestring_0384C4", "de", "Nichts ausgeruestet."},

{"widestring_0389FF", "es", "¿Tocar la flauta?| Sí| No"},
{"widestring_0389FF", "fr", "Jouer de la flute?| Oui| Non"},
{"widestring_0389FF", "de", "Floete spielen?| Ja| Nein"},

{"widestring_039961", "es", "Es el dinero del premio|del Cristal Ruso."},
{"widestring_039961", "fr", "C'est le prix gagne|au Verre Russe."},
{"widestring_039961", "de", "Das Preisgeld vom|Russischen Glas."},

{"widestring_05EB2E", "es", "Neil: |Hablaremos de ello |cuando vuelvan todos. |Neil: ¡Claro! |Cygnus tiene 9 estrellas,|y hay nueve|piedras... "},
{"widestring_05EB2E", "fr", "Neil: |On en parlera quand |tout le monde sera la. |Neil: Bien sur! |Cygnus a neuf etoiles,|et il y a neuf|pierres... "},
{"widestring_05EB2E", "de", "Neil: |Wir reden darueber, |wenn alle zurueck sind. |Neil: Natuerlich! |Cygnus hat neun Sterne,|und es gibt neun|Steine... "},

{"widestring_05F8F7", "es", "Will: Había un viento |tremendo en el |Acantilado Larai. |Seguro que a eso se |refería el anciano con |el aliento espiritual.... |Este es el acantilado|sin viento. El corazón|me late con fuerza."},
{"widestring_05F8F7", "fr", "Will: Il y avait un |vent terrible sur la |falaise de Larai. |C'est surement ce que |le vieil homme appelait |le souffle des esprits... |Voici la falaise|sans vent. Mon coeur|bat tres fort."},
{"widestring_05F8F7", "de", "Will: Auf der Larai- |Klippe wehte ein |gewaltiger Wind. |Das meinte der Alte |wohl mit dem |Atem der Geister.... |Dies ist die Klippe|ohne Wind. Mein Herz|klopft heftig."},

{"widestring_06C714", "es", "No sé desde cuándo|vivimos aquí.|Pero cuando miro el |mar, me duele el alma. "},
{"widestring_06C714", "fr", "Je ne sais plus depuis|quand nous vivons ici.|Quand je regarde la |mer, j'ai le coeur gros. "},
{"widestring_06C714", "de", "Ich weiss nicht, seit|wann wir hier leben.|Sehe ich aufs Meer, |schmerzt mein Herz. "},

{"widestring_06C799", "es", "Este es el Pueblo |Angel. Si el sol nos da |mucho tiempo en el |cuerpo, moriremos. "},
{"widestring_06C799", "fr", "Voici le Village |des Anges. Si le soleil |touche nos corps trop |longtemps, nous perirons. "},
{"widestring_06C799", "de", "Dies ist das Engels- |dorf. Wenn die Sonne |uns lange trifft, |sterben wir. "},

{"widestring_0799AF", "es", "Will: Se me está|durmiendo el cuerpo...."},
{"widestring_0799AF", "fr", "Will: Mon corps|s'engourdit...."},
{"widestring_0799AF", "de", "Will: Mein Koerper|wird taub...."},

{"widestring_07B5FA", "es", "Cae una piedra pequeña."},
{"widestring_07B5FA", "fr", "Une petite pierre tombe."},
{"widestring_07B5FA", "de", "Ein Steinchen faellt."},

{"widestring_0892FF", "es", "La estatua de una chica |permanece en silencio. "},
{"widestring_0892FF", "fr", "La statue d'une fille |se tient en silence. "},
{"widestring_0892FF", "de", "Die Statue eines |Maedchens steht still. "},

{"widestring_08931A", "es", "¡La estatua se ha|convertido en una chica!|Una lágrima asoma a|sus ojos..."},
